{
  "manifest_version": 1,
  "id": "org.example.voxel_probe",
  "name": "Voxel Probe",
  "version": "0.1.0",
  "engines": {
    "vizi": "1.0"
  },
  "min_vizi": "1.0.0",
  "sdk_version": "1.0.0",
  "entry": {
    "command": [
      "./run"
    ]
  },
  "contributions": {
    "commands": [
      {
        "id": "probe.snapshot",
        "title": "Snapshot the trail",
        "menu": null
      },
      {
        "id": "probe.clear",
        "title": "Clear the probe",
        "menu": null
      }
    ],
    "panels": [
      {
        "id": "probe",
        "title": "Voxel Probe",
        "root": {
          "kind": "column",
          "id": "root",
          "children": [
            {
              "kind": "label",
              "id": "status",
              "text": "No gesture yet"
            },
            {
              "kind": "image",
              "id": "snapshot"
            },
            {
              "kind": "button",
              "id": "snap",
              "command": "probe.snapshot",
              "text": "Snapshot"
            },
            {
              "kind": "button",
              "id": "clear",
              "command": "probe.clear",
              "text": "Clear"
            }
          ]
        }
      }
    ],
    "overlays": [
      {
        "id": "probe_marker",
        "name": "Probe marker"
      },
      {
        "id": "probe_trail",
        "name": "Probe trail",
        "segment_mib": 4
      }
    ],
    "tools": [
      {
        "id": "probe",
        "name": "Voxel probe",
        "views": [
          "2d",
          "3d"
        ]
      }
    ]
  }
}
