      "expected": {"kind": "accepted"}
    },
    {
      "name": "a leading zero in the major is accepted",
      "json": {"manifest_version": 1, "id": "org.example.grammar", "name": "Grammar", "version": "1", "engines": {"vizi": "01.0"}, "entry": {"command": ["python3"]}},
      "expected": {"kind": "accepted"}
    },
    {
      "name": "leading zeros in the minor are accepted",
      "json": {"manifest_version": 1, "id": "org.example.grammar", "name": "Grammar", "version": "1", "engines": {"vizi": "1.00"}, "entry": {"command": ["python3"]}},
      "expected": {"kind": "accepted"}
    },
    {
      "name": "leading zeros after a prefix are accepted",
      "json": {"manifest_version": 1, "id": "org.example.grammar", "name": "Grammar", "version": "1", "engines": {"vizi": "^001.000"}, "entry": {"command": ["python3"]}},
      "expected": {"kind": "accepted"}
    },
    {
      "name": "the largest minor, 4294967295, is a version",
      "json": {"manifest_version": 1, "id": "org.example.grammar", "name": "Grammar", "version": "1", "engines": {"vizi": "1.4294967295"}, "entry": {"command": ["python3"]}},
      "expected": {"kind": "engines_incompatible", "message": "Grammar 1 needs vizi protocol 1.4294967295; this vizi speaks 1.0"}
    },
    {
      "name": "the largest major, 4294967295, is a version",
      "json": {"manifest_version": 1, "id": "org.example.grammar", "name": "Grammar", "version": "1", "engines": {"vizi": "4294967295.0"}, "entry": {"command": ["python3"]}},
      "expected": {"kind": "engines_incompatible", "message": "Grammar 1 needs vizi protocol 4294967295.0; this vizi speaks 1.0"}
    },
