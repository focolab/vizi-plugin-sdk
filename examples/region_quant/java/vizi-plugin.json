{
  "manifest_version": 1,
  "id": "org.example.region_quant",
  "name": "Region Quant",
  "version": "0.1.0",
  "engines": {
    "vizi": "1.0"
  },
  "min_vizi": "1.0.0",
  "sdk_version": "1.0.0",
  "entry": {
    "command": [
      "./region-quant"
    ]
  },
  "contributions": {
    "commands": [
      {
        "id": "quant.channel",
        "title": "Measure a channel",
        "menu": null
      },
      {
        "id": "quant.pick",
        "title": "Select a region",
        "menu": null
      },
      {
        "id": "quant.brightest",
        "title": "Go to the brightest frame",
        "menu": null
      },
      {
        "id": "quant.export",
        "title": "Export region means",
        "menu": null
      }
    ],
    "panels": [
      {
        "id": "quant",
        "title": "Region Quant",
        "view_targets": [
          "t",
          "select_region"
        ],
        "follow_targets": [
          "frame_region"
        ],
        "root": {
          "kind": "column",
          "id": "root",
          "children": [
            {
              "kind": "channel_picker",
              "id": "channel",
              "command": "quant.channel",
              "value": 0
            },
            {
              "kind": "list",
              "id": "regions",
              "row": [
                {
                  "kind": "label",
                  "id": "name",
                  "text": ""
                },
                {
                  "kind": "label",
                  "id": "voxels",
                  "text": ""
                },
                {
                  "kind": "label",
                  "id": "mean",
                  "text": ""
                },
                {
                  "kind": "image",
                  "id": "swatch"
                }
              ],
              "max_rows": 1024,
              "selectable": true,
              "command": "quant.pick",
              "moves_view": true
            },
            {
              "kind": "button",
              "id": "brightest",
              "command": "quant.brightest",
              "text": "Brightest frame",
              "moves_view": true
            },
            {
              "kind": "button",
              "id": "export",
              "command": "quant.export",
              "text": "Export CSV…"
            },
            {
              "kind": "label",
              "id": "tracing",
              "text": ""
            },
            {
              "kind": "label",
              "id": "status",
              "text": "Ready"
            }
          ]
        }
      }
    ]
  },
  "permissions": [
    "data_access"
  ],
  "subscriptions": [
    "view",
    "regions"
  ]
}
