//| mill-version: 1.1.3
//| mill-jvm-version: 25
package build
import mill.*, javalib.*

// The stage-chain plugin on the Java SDK, which ./assemble publishes to ~/.m2 first.
object `package` extends JavaModule {
  def repositories = Task { super.repositories() ++ Seq("m2Local") }
  def mvnDeps = Seq(mvn"org.focolab:vizi-sdk-java:1.0.0")
  def mainClass = Some("StageChain")
  def javacOptions = Seq("--release", "25", "-Xlint:all")

  object test extends JavaTests, TestModule.Junit5 {
    def jupiterVersion = "5.13.4"
    def forkArgs = Seq("--enable-native-access=ALL-UNNAMED", "--sun-misc-unsafe-memory-access=allow")
  }
}
