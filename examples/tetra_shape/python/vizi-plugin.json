{
  "manifest_version": 1,
  "id": "org.example.tetra_shape",
  "name": "Tetra Shape",
  "version": "0.1.0",
  "engines": { "vizi": "1.0" },
  "entry": { "command": [".venv/bin/python", "tetra_shape.py"] },
  "permissions": ["contribute_rois"],
  "contributions": {
    "commands": [
      { "id": "tetra.contribute", "title": "Contribute the tetrahedra", "menu": null }
    ],
    "region_types": [
      { "id": "tetra.volume", "name": "Tetrahedron (keeps its volume)" },
      { "id": "tetra.unshaped", "name": "Tetrahedron (no shaper)" }
    ]
  }
}
