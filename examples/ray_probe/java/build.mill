//| mill-version: 1.1.3
//| mill-jvm-version: 25
package build
import mill.*, javalib.*

// The ray-probe plugin on the Java SDK, which ./assemble publishes to ~/.m2 first.
object `package` extends JavaModule {
  def repositories = Task { super.repositories() ++ Seq("m2Local") }
  def mvnDeps = Seq(mvn"org.focolab:vizi-sdk-java:1.0.0")
  def mainClass = Some("RayProbe")
  def javacOptions = Seq("--release", "25", "-Xlint:all")

  // The pane icons ride in the jar as resources at the paths the manifest names (icons/...), so
  // --install packages them from wherever it is run; the development copy reads ./icons.
  def iconDir = Task.Source(moduleDir / "icons")
  def iconResources = Task {
    os.copy(iconDir().path, Task.dest / "icons")
    PathRef(Task.dest)
  }
  def resources = Task { super.resources() ++ Seq(iconResources()) }

  object test extends JavaTests, TestModule.Junit5 {
    def jupiterVersion = "5.13.4"
    def forkArgs = Seq("--enable-native-access=ALL-UNNAMED", "--sun-misc-unsafe-memory-access=allow")
    // the plugin directory, for the manifest and icon checks
    def forkEnv = Task { super.forkEnv() ++ Map("RAY_PROBE_DIR" -> (moduleDir / os.up).toString) }
  }
}
